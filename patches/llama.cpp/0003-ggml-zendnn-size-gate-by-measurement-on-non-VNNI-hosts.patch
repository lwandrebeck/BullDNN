@@ -759,6 +775,49 @@
     GGML_UNUSED(max_tensor_size);
 }
 
+// AVX-512 VNNI decides WHO runs a per-group INT8 matmul: with it, AOCL-DLP;
+// without it, BullDNN's native 128-bit kernels. The two have different
+// crossovers, so the size gate below has to know which one it is talking about.
+static bool ggml_zendnn_host_has_avx512vnni() {
+    static const bool v = __builtin_cpu_supports("avx512vnni");
+    return v;
+}
+
+// Is there a GPU device registered that would otherwise take this op? Prompt
+// matmuls go to it whatever -ngl says -- llama.cpp schedules ops independently
+// of where the weights live -- and it is roughly four times faster at them than
+// any CPU kernel here. Accepting such an op does not make it faster; it moves it
+// to the slower machine.
+static bool ggml_zendnn_gpu_present() {
+    static const bool present = [] {
+        // GGML_ZENDNN_IGNORE_GPU=1 says "there is a GPU in this machine but it
+        // is not being used for this run". supports_op cannot tell the two
+        // apart: it sees the registered devices, not the scheduler's backend
+        // set, so a -dev none run on a GPU-equipped box looks identical to a
+        // hybrid one from here. Without the override such a run keeps only
+        // decode and gives up the prompt win -- on the FX, 44.53 t/s becomes
+        // 33.05. With it, CPU-only gets the full 1.36x back.
+        const char *ignore = std::getenv("GGML_ZENDNN_IGNORE_GPU");
+        if (ignore != nullptr && std::atoi(ignore) != 0) return false;
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            if (ggml_backend_dev_type(ggml_backend_dev_get(i))
+                    == GGML_BACKEND_DEVICE_TYPE_GPU) {
+                return true;
+            }
+        }
+        return false;
+    }();
+    return present;
+}
+
+// AVX2 decides whether ggml's own kernels are strong. Without it (Bulldozer,
+// Piledriver, Steamroller) ggml is confined to SSSE3 and these 128-bit kernels
+// beat it; with it (Excavator) they do not.
+static bool ggml_zendnn_host_has_avx2() {
+    static const bool v = __builtin_cpu_supports("avx2");
+    return v;
+}
+
 static bool ggml_zendnn_adaptive_fallback_enabled() {
     static const bool enabled = std::getenv("GGML_ZENDNN_ADAPTIVE_FALLBACK") == nullptr ||
                                 std::atoi(std::getenv("GGML_ZENDNN_ADAPTIVE_FALLBACK")) != 0;
@@ -790,11 +849,74 @@
                 return false;
             }
 
+            // The compute path ASSERTS that the destination is neither
+            // transposed nor permuted:
+            //
+            //     GGML_ASSERT(nb0 == sizeof(float));
+            //     GGML_ASSERT(nb0 <= nb1); nb1 <= nb2; nb2 <= nb3;
+            //
+            // and supports_op never checked it, so such an op was accepted and
+            // then killed the process instead of falling back. llama-perplexity
+            // produces exactly one -- it aborted there while llama-bench, which
+            // never builds that shape, was fine. An assert in a compute path is
+            // a statement about what the CALLER must not pass; the gate that
+            // admits the caller has to enforce it.
+            if (!(op->nb[0] == sizeof(float) && op->nb[0] <= op->nb[1]
+                        && op->nb[1] <= op->nb[2] && op->nb[2] <= op->nb[3])) {
+                if (zendnn_dispatch_stats::enabled()) g_zendnn_stats.rejected[weights->type]++;
+                return false;
+            }
+
             if (ggml_zendnn_adaptive_fallback_enabled()) {
                 const int64_t K = inputs->ne[0];
                 const int64_t N = (inputs->ne[1]*inputs->ne[2]*inputs->ne[3]);
                 const int64_t M = weights->ne[1];
-                if(K <= 256 || N <= 128 || M <= 96) {
+
+                // The N > 128 rule assumes ZenDNN loses below a large batch,
+                // which holds where AOCL-DLP does the work. Where BullDNN's
+                // native kernels do it the answer is different, and it is not
+                // one rule -- it depends on what else could have run the op.
+                // Measured end to end, qwen2.5-1.5B Q4_K_M, prompt(512) and
+                // generation(128), stock ggml against this fork:
+                //
+                //   FX-8370E  (bdver2, no AVX2)  cpu     1.36x / 1.06x
+                //   A10-8770E (bdver4, AVX2)     cpu     0.98x / 0.86x
+                //   FX-8370E                     hybrid  0.27x / 1.03x
+                //   A10-8770E                    hybrid  0.33x / 0.99x
+                //
+                // Two things follow. First, the CPU win is a NO-AVX2 result:
+                // without AVX2 ggml is on SSSE3 like these kernels and they beat
+                // it; with AVX2 it is ahead and accepting the op loses. Second, a
+                // GPU beats both at prompt sizes by about 4x, and llama.cpp sends
+                // prompt matmuls to it regardless of -ngl -- at ngl=0, with every
+                // layer CPU-resident, stock still measured 257 t/s against 52 for
+                // this fork. So "the model does not fit in VRAM" is not a case for
+                // taking that work: residency is not what decides who runs it.
+                //
+                // Generation is the exception and stays worth taking. It is
+                // memory-bound, the GPU has no advantage there (hybrid tg is
+                // 1.03x and 0.99x above), and the decode GEMV is ahead on the
+                // parts without AVX2.
+                if (!ggml_zendnn_host_has_avx512vnni()) {
+                    if (K <= 256 || M <= 96) {
+                        return false;
+                    }
+                    if (ggml_zendnn_host_has_avx2()) {
+                        return false; // ggml's own kernels are the better choice
+                    }
+                    // Two and three tokens are the GEMV/GEMM gap: too many rows
+                    // for the one-row kernel, and the GEMM pads M to its tile of
+                    // four and throws half the work away.
+                    if (N == 2 || N == 3) {
+                        return false;
+                    }
+                    // With a GPU in the machine, leave prompt-sized work to it
+                    // and keep only decode.
+                    if (ggml_zendnn_gpu_present() && N > 1) {
+                        return false;
+                    }
+                    // otherwise fall through to the per-type check below
+                } else if (K <= 256 || N <= 128 || M <= 96) {
                     return false;
                 }
 
@@ -825,6 +947,7 @@
                     ok = true;
                     break;
                 case GGML_TYPE_Q4_K:
+                case GGML_TYPE_Q6_K:
                 case GGML_TYPE_Q5_K:
                     // The k-quant unpack needs whole 256-weight super-blocks.
                     ok = (weights->ne[0] % 256) == 0;
