     const bool zendnn_wants_f32_src1 = src0->type == GGML_TYPE_Q8_0 ||
                                        src0->type == GGML_TYPE_Q4_K ||
-                                       src0->type == GGML_TYPE_Q5_K;
+                                       src0->type == GGML_TYPE_Q5_K ||
+                                       src0->type == GGML_TYPE_Q6_K;
     if (src1->type != vec_dot_type && !zendnn_wants_f32_src1) {
         const size_t nbw1 = ggml_row_size(vec_dot_type, ne10);
         const size_t nbw2 = nbw1 * ne11;
@@ -346,7 +361,8 @@
         // src_scale.dims depends on this expert's row count, unlike the rest of base_params
         if constexpr (std::is_same_v<TA, block_q8_0> ||
                       std::is_same_v<TA, block_q4_K> ||
-                      std::is_same_v<TA, block_q5_K>) {
+                      std::is_same_v<TA, block_q5_K> ||
+                  std::is_same_v<TA, block_q6_K>) {
             params[i].quant_params.src_scale.dims = {n[i], k / QK8_0};
