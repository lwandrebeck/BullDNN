         params.quant_params.src_scale.dt   = zendnnl::common::data_type_t::bf16;
         params.packing.pack_format_b = 1;
-    } else if constexpr (std::is_same_v<TA, block_q4_K> || std::is_same_v<TA, block_q5_K>) {
+    } else if constexpr (std::is_same_v<TA, block_q4_K> || std::is_same_v<TA, block_q5_K>
+                         || std::is_same_v<TA, block_q6_K>) {
         // Asymmetric per-group weights. Q8_0 gets away without naming its GGML
         // type because the library infers it from the s8 weight dtype; a k-quant
         // has to be named, and the unpack then produces the min array the
@@ -95,7 +98,9 @@
         params.quant_params.src_scale.buff = nullptr;
         params.quant_params.src_scale.dt   = zendnnl::common::data_type_t::bf16;
         params.packing.pack_format_b = 1;
-        params.packing.ggml_type_b   = std::is_same_v<TA, block_q4_K> ? 12 : 13;
+        params.packing.ggml_type_b   = std::is_same_v<TA, block_q4_K> ? 12
+                : std::is_same_v<TA, block_q5_K>                        ? 13
+                                                                       : 14;
     }
     return params;
 }
@@ -123,7 +128,8 @@
 
     if constexpr (std::is_same_v<TA, block_q8_0> ||
                   std::is_same_v<TA, block_q4_K> ||
-                  std::is_same_v<TA, block_q5_K>) {
+                  std::is_same_v<TA, block_q5_K> ||
+                  std::is_same_v<TA, block_q6_K>) {
         // Group is 32 for all of these, so the per-token/per-group shape matches.
         params.quant_params.src_scale.dims = {n, k / QK8_0};
     }
@@ -204,6 +210,14 @@
                 (const block_q4_K *)A, lda,
                 (const float *)B, ldb,
                 (float *)C, ldc);
+        case GGML_TYPE_Q6_K:
+            if (Btype != GGML_TYPE_F32 || Ctype != GGML_TYPE_F32)
+                return false;
+            return ggml_zendnn_matmul<block_q6_K, float, float>(
+                ctx, m, n, k,
+                (const block_q6_K *)A, lda,
+                (const float *)B, ldb,
+                (float *)C, ldc);
         case GGML_TYPE_Q5_K:
