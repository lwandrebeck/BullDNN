+++ b/ggml/src/ggml-zendnn/ggml-zendnn.cpp	2026-08-16 18:38:11.817527822 +0000
@@ -835,6 +835,30 @@
     return v;
 }
 
+// GGML_ZENDNN_ONLY_TYPES=q4_K,q6_K restricts what this backend will accept.
+//
+// It exists for attribution, not for production. The scheduler hands over
+// whatever mixture it likes -- on qwen2.5-1.5B Q4_K_M that is 3866 Q4_K ops and
+// 669 Q6_K ops -- and a result measured over the mixture cannot say which
+// kernel moved it. Q6_K is this fork's weakest k-quant, sixteen reductions per
+// super-block against Q4_K's eight, and it sits on the decode path in every
+// layer, so it is exactly the one that could carry a generation loss on its own.
+// Unset, everything is allowed and this costs one predictable branch.
+static bool ggml_zendnn_type_allowed(enum ggml_type t) {
+    static const char *only = std::getenv("GGML_ZENDNN_ONLY_TYPES");
+    if (only == nullptr || only[0] == '\0') return true;
+    const char *name = ggml_type_name(t);
+    const size_t len = strlen(name);
+    for (const char *p = only; *p != '\0';) {
+        const char *end = strchr(p, ',');
+        const size_t n = end ? (size_t)(end - p) : strlen(p);
+        if (n == len && strncmp(p, name, n) == 0) return true;
+        if (!end) break;
+        p = end + 1;
+    }
+    return false;
+}
