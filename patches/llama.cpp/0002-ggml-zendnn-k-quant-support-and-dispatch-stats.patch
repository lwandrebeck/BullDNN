+// ---- dispatch statistics (ZENDNN_DISPATCH_STATS=1) -------------------------
+// Counts, per weight type, how many MUL_MAT/MUL_MAT_ID ops ZenDNN accepted and
+// how many it actually executed. Printed at exit. Without this there is no way
+// to tell "this fork made no difference" from "this fork never ran".
+struct zendnn_dispatch_stats {
+    std::atomic<uint64_t> accepted[GGML_TYPE_COUNT] = {};
+    std::atomic<uint64_t> rejected[GGML_TYPE_COUNT] = {};
+    std::atomic<uint64_t> executed[GGML_TYPE_COUNT] = {};
+
+    static bool enabled() {
+        static const bool e = getenv("ZENDNN_DISPATCH_STATS") != nullptr &&
+                              atoi(getenv("ZENDNN_DISPATCH_STATS")) != 0;
+        return e;
+    }
+    ~zendnn_dispatch_stats() {
+        if (!enabled()) return;
+        fprintf(stderr, "\n=== ZenDNN dispatch statistics ===\n");
+        fprintf(stderr, "%-12s %12s %12s %12s\n", "weight type", "accepted", "rejected", "executed");
+        for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+            const uint64_t a = accepted[t].load(), r = rejected[t].load(), x = executed[t].load();
+            if (a == 0 && r == 0 && x == 0) continue;
+            fprintf(stderr, "%-12s %12llu %12llu %12llu\n",
+                    ggml_type_name((ggml_type) t),
+                    (unsigned long long) a, (unsigned long long) r, (unsigned long long) x);
+        }
+        fprintf(stderr, "==================================\n");
+    }
+};
+static zendnn_dispatch_stats g_zendnn_stats;
+
